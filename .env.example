# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env

# --- Model: Claude (default) ---
#
# NOTHING TO SET. The desk uses your local Claude Code login.
# Install it once and sign in:
#   npm i -g @anthropic-ai/claude-code
#   claude            (then /login)
# Your Max/Pro subscription powers the desk. No API key anywhere.
#
# Which Claude. Default claude-opus-5. Applies to both Claude paths.
# ANTHROPIC_MODEL=claude-opus-5
#
# If the CLI is somewhere unusual, point at the binary:
# CLAUDE_CLI_PATH=C:\Users\you\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe
#
# Take the CLI out of the chain entirely (also makes `npm test` skip the one
# live-API test, so a test run costs nothing):
# TOWNREPORTER_CLAUDE_CODE=0

# --- Model: Claude by API key (optional, beats the CLI) ---
# Only if you'd rather bill an API key than use the subscription.
# Key: https://console.anthropic.com
# ANTHROPIC_API_KEY=
#
# API-key path only. How hard it thinks: low | medium | high | xhigh | max.
# Default high. Lower is cheaper and faster; higher reads better.
# ANTHROPIC_EFFORT=high

# --- Model: Grok (fallback) ---
# Only used when ANTHROPIC_API_KEY is empty. Key: https://console.x.ai
# XAI_API_KEY=
# XAI_MODEL=grok-4.5
# XAI_BASE_URL=https://api.x.ai/v1

# --- Other models: any OpenAI-compatible /v1/chat/completions gateway ---
# If LLM_BASE_URL or LLM_API_KEY is set, this wins over BOTH Claude and Grok.
# This is the hook for running a local model on the box instead of paying per word.
# Same three vars for LiteLLM, Bifrost, Helicone, MLflow, Kong, Ollama, OpenAI.
#
# LiteLLM:          LLM_BASE_URL=http://127.0.0.1:4000/v1
# Bifrost:          LLM_BASE_URL=http://127.0.0.1:4000/v1
#                   (Bifrost's own default port is 8080 — that collides with
#                   TownReporter. Map it: docker run -p 4000:8080 maximhq/bifrost)
# Helicone:         LLM_BASE_URL=https://oai.helicone.ai/v1
#                   (or your self-hosted Helicone worker)
# MLflow AI Gateway: LLM_BASE_URL=http://127.0.0.1:5000/v1
# Kong AI Gateway:  LLM_BASE_URL=http://127.0.0.1:8000/v1
# OpenAI:           LLM_BASE_URL=https://api.openai.com/v1
# OpenRouter:       LLM_BASE_URL=https://openrouter.ai/api/v1
# Ollama:           LLM_BASE_URL=http://127.0.0.1:11434/v1
#                   LLM_API_KEY=ollama
#                   LLM_MODEL=llama3.1
#
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# --- Database ---
# Unset = local PGLite (data dies when the process stops).
# DATABASE_URL=postgres://user:pass@host:5432/townreporter

# --- Desk sign-in ---
# Self-host: open /login and create an editor account (email + password).
# That lives in YOUR database. Grok Google/X buttons only show on *.grok.me
# unless you set VITE_GROK_OAUTH=true and the GROK_AUTH_* broker vars.
# BETTER_AUTH_URL=http://localhost:8080
# BETTER_AUTH_SECRET=generate-a-long-random-string
#
# Unsigned-in local editor. Do not use on a public host.
# VITE_AUTH_ENABLED=false
#
# Claim the desk on a public host. When set, the first owner must pass this token.
# Preview (*.grok.me) still lets the first account own the desk without a token.
# NEWSROOM_SETUP_TOKEN=
#
# Background monitor tick. Empty = the cron URL is disabled (fail closed).
# CRON_SECRET=

# ── Where it listens ──────────────────────────────────────────────────────────
# PORT defaults to 3000. HOST defaults to every interface, which means the app
# also answers on your local network. Set HOST when something else fronts it
# (a Cloudflare Tunnel, a reverse proxy) so that is the only way in.
# PORT=3000
# HOST=127.0.0.1

# ── Everything else the code reads ────────────────────────────────────────────
# An audit found this file was not the inventory docs/setup.md claims it is
# (TW-006). These are the remaining variables the application actually consults.
# Grok-broker settings are preview-only and are listed for completeness.
#
# Model routing
# TOWNREPORTER_PLANNER_MODEL=   # override the Dark Desk planner model on any provider
# TOWNREPORTER_EDITORIAL_MODEL= # override the Opinion model (default claude-opus-5)
# EDITORIAL_TIMEOUT_MS=2700000  # ceiling for one editorial. Measured runs: 9m53s to >30m.
# OPENAI_API_KEY=               # only read as a fallback for an OpenAI-compatible gateway
#
# The paper's own address, used for canonical URLs, the sitemap and the feed
# PUBLIC_SITE_URL=https://your-paper.example
#
# Extra origins Better Auth should trust (comma separated). Rarely needed.
# BETTER_AUTH_TRUSTED_ORIGINS=
#
# Tests
# RUN_LIVE_MODEL_TESTS=1        # opt in to the live model evaluation; see npm run test:live-model
#
# Preview only (grok.me). Ignored on a self-host.
# GROK_PROJECT_ID=
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_GATE_ORIGIN=
# GROK_CONNECTORS_URL=
# GROK_CONNECTOR_ACCESS_TOKEN=
# GROK_API_KEY=
