node_modules/
.project_id
.github_repo
.env
.env.*
!.env.example
logs/
.output/
# ops/promote.ps1 keeps the build that is running before it builds a new one,
# so a build that does not work can be undone. One directory, replaced on each
# promotion, never committed: it would otherwise sit in `git status` output and
# be swept away by a `git clean -fd` on the machine serving the paper.
.output-previous/

# ops/stage.ps1 run state -- machine-local, never the deliverable.
ops/.stage.pid
ops/.stage.json
ops/stage.out.log
ops/stage.err.log
# ops/start-stage.ps1 moves the two logs above aside before starting, so the
# run that failed is still readable after the one that replaced it.
ops/stage.out.prev.log
ops/stage.err.prev.log
.vercel/
.tanstack/
.node_modules.lock
attachments/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.local

# Native model/browser research scratch. Preserve gate evidence outside the
# checkout; never let a broad `git add` publish downloaded records or Chromium
# diagnostics as source.
.tmp-editorial-*/
debug.log

# Unit UI1b's clickable-controls guard writes its measured report here
# (scripts/desk-clickable-guard-walk.mjs). It is evidence about one build, not
# source: the run is repeatable and the numbers move with every conversion, so
# the file must never be committed. The baseline a reader wants is quoted in
# the unit's report, not read out of a stale copy in the checkout.
tmp-guard/

# Transient capture and build output. An audit found 150 screenshots (11 MB)
# and 25 browser captures plus five duplicate source archives (3.9 MB) tracked
# here (ENG-010). Clones pay for those forever, and a committed source archive
# can be mistaken for canonical code.
#
# docs/images/ stays tracked on purpose: curated manual screenshots that
# the documentation links to. That is the deliberate exception.
screenshots/
artifacts/browsed_files/
artifacts/*.zip
artifacts/*.tar.gz
artifacts/*.bin
artifacts/*.html
artifacts/RENAME-TO-ZIP.txt

# Audit evidence: the written reports are the deliverable and stay tracked;
# the screenshots and capture data behind them are reproducible output.
# Per-prefix rules (artifacts/audit-*/...) rotted -- gate-* and gauntlet-*
# evidence slipped past them (ENG-010). This is prefix-proof: ignore every
# file under artifacts/, then re-include only the Markdown reports.
artifacts/**
!artifacts/**/
!artifacts/**/*.md

# Claude Code session worktrees and local settings are never part of the paper
.claude/

# Per-install pointer (persistent secrets/data live outside the source tree).
.townreporter-install.json

# Development-only fallback for generated aggregate Stats reports.
/.townreporter-data/

# Written at run time by the meeting-capture tests and the live desk; never source.
meeting-capture/
meeting-captions/
