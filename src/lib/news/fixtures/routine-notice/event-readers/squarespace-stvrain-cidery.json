      "body": "<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6ac13109fcdbcf364905e5bf\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/0adf77ad-25ba-4033-b57d-f0d5d3117ab8_1023/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/0adf77ad-25ba-4033-b57d-f0d5d3117ab8_1023/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"0a65f62681a94658d44e\" id=\"block-0a65f62681a94658d44e\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"white-space:pre-wrap;\" class=\"sqsrte-large\" data-rte-preserve-empty=\"true\">🎃 <strong>Squirrel Junction on Halloween!</strong> 👻<br><strong>Saturday, October 31 • 6:30–8:30 PM</strong></p><p class=\"sqsrte-large\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Celebrate Halloween with some seriously fun bluegrass! Squirrel Junction brings their playful Front Range sound to the taproom with great lyrics, lively fiddle tunes, original takes, and plenty of silly animal songs. 🐿️🎻</p><p class=\"sqsrte-large\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Grab a cider, get cozy, and spend Halloween night with us!</p></div>\n\n\n  \n<style id=\"container-styles\">#block-0a65f62681a94658d44e {\n    \n    \n    \n  }\n\n  #block-0a65f62681a94658d44e .sqs-html-content {\n    \n    }\n\n  #block-0a65f62681a94658d44e {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n 