  routine: 'parse_extension_control_file',
  query: '-- Make the public archive search an indexed lookup instead of a table scan.\n' +
    '--\n' +
    '-- /?q= is open to anyone with no session and no rate limit, and the query was\n' +
    "-- `headline ilike '%q%' or dek ilike '%q%' or body ilike '%q%'`. A leading\n" +
    '-- wildcard cannot use a btree index, so every anonymous keystroke read every\n' +
    '-- published body end to end. An audit filed it as ENG-008: cheap to send,\n' +
    '-- unbounded to serve.\n' +
    '--\n' +
    '-- pg_trgm keeps the behaviour exactly as it is -- substring matching, so\n' +
    '-- "ouncil" still finds "council" -- and makes it index-backed. A tsvector\n' +
    '-- index would be smaller but would only match whole words, which is a\n' +
    '-- different search than the one the paper advertises.\n' +
    '--\n' +
    '-- The extension is wrapped because a self-hoster may not be a superuser. If it\n' +
    '-- cannot be installed the paper still works; the search is simply as slow as\n' +
    '-- it was before, and says so in the log rather than refusing to start.\n' +
    'DO $$\n' +
    'BEGIN\n' +
    '  CREATE EXTENSION IF NOT EXISTS pg_trgm;\n' +
    'EXCEPTION WHEN insufficient_privilege THEN\n' +
    "  RAISE NOTICE 'pg_trgm needs a superuser. Archive search stays unindexed.';\n" +
    'END\n' +
    '$$;\n' +
    '\n' +
    'DO $$\n' +
    'BEGIN\n' +
    "  IF EXISTS (SELECT 1 FROM pg_extension WHERE extname = 'pg_trgm') THEN\n" +
    '    -- Partial on purpose: drafts are never searched from the paper, so the\n' +
    '    -- index only carries what a reader can actually reach.\n' +
    '    CREATE INDEX IF NOT EXISTS articles_headline_trgm\n' +
    "      ON articles USING gin (headline gin_trgm_ops) WHERE status = 'published';\n" +
    '    CREATE INDEX IF NOT EXISTS articles_dek_trgm\n' +
    "      ON articles USING gin (dek gin_trgm_ops) WHERE status = 'published';\n" +
    '    CREATE INDEX IF NOT EXISTS articles_body_trgm\n' +
    "      ON articles USING gin (body gin_trgm_ops) WHERE status = 'published';\n" +
    '  END IF;\n' +
    'END\n' +
    '$$;\n',
  params: undefined,
  queryOptions: undefined
}
